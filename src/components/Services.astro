---
import { copy, type LocaleCode } from '../content/locales';
const { locale } = Astro.props as { locale: LocaleCode };
const t = copy[locale];
---
<section class="section services rail" id="servicios" tabindex="-1" aria-labelledby="services-title" data-line-anchor="services">
  <div class="section-intro" data-reveal>
    <div class="section-heading"><span class="section-index" aria-hidden="true">02 /</span><h2 id="services-title">{t.nav[1]}</h2></div>
    <p>{t.servicesIntro}</p>
  </div>
  <div class="service-stack" data-service-stack>
    {t.services.map((service, index) => <article class="service-panel" data-service-panel style={`--stack-index:${index}`}>
      <span class="service-count" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <div><h3>{service.title}</h3><p>{service.body}</p></div>
    </article>)}
  </div>
  <div class="capabilities" data-reveal>{t.capabilities.map((paragraph) => <p>{paragraph}</p>)}</div>
</section>
