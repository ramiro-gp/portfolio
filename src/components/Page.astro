---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import Hero from './Hero.astro';
import Services from './Services.astro';
import Projects from './Projects.astro';
import About from './About.astro';
import Contact from './Contact.astro';
import Line from './Line.astro';
import type { LocaleCode } from '../content/locales';
import Analytics from './Analytics.astro';
import { analyticsId, privacyCopy } from '../content/analytics';

const { locale } = Astro.props as { locale: LocaleCode };
---
<BaseLayout locale={locale}>
  <SiteHeader locale={locale} />
  <Line />
  <main id="main" tabindex="-1">
    <Hero locale={locale} />
    <Services locale={locale} />
    <Projects locale={locale} />
    <About locale={locale} />
    <Contact locale={locale} />
  </main>
  <footer class="footer rail"><span>ramita<span class="brand-dot">.</span>dev</span><div class="footer-utilities"><a href="/privacidad/">{privacyCopy[locale].privacy}</a>{analyticsId && <button type="button" data-consent-preferences hidden>{privacyCopy[locale].preferences}</button>}<span>Ramiro Garcia</span></div></footer>
  <Analytics locale={locale} />
  <div class="custom-cursor" aria-hidden="true" data-cursor></div>
</BaseLayout>
