---
import { analyticsId, privacyCopy } from '../content/analytics';
import type { LocaleCode } from '../content/locales';
const { locale } = Astro.props as { locale: LocaleCode };
const t = privacyCopy[locale];
---
{analyticsId && <aside class="cookie-notice" data-consent-notice data-measurement-id={analyticsId} aria-label={t.preferences} hidden>
  <p>{t.text} <a href="/privacidad/">{t.privacy}</a></p>
  <div><button type="button" data-consent-accept>{t.accept}</button><button type="button" data-consent-reject>{t.reject}</button></div>
</aside>}
<script src="../scripts/analytics.ts"></script>
<style>
  .cookie-notice{position:fixed;z-index:120;inset:auto 16px 16px;margin-inline:auto;max-width:760px;padding:16px 20px;border:1px solid var(--divider);background:var(--bg);color:var(--text);display:flex;align-items:center;gap:20px;box-shadow:0 4px 20px #00000012;font-size:.9375rem;line-height:1.5}
  .cookie-notice[hidden]{display:none}.cookie-notice p{margin:0}.cookie-notice>div{display:flex;gap:8px;flex-shrink:0}.cookie-notice button{font:inherit;color:var(--text);background:transparent;border:1px solid var(--divider);padding:8px 12px;min-height:44px;cursor:pointer}.cookie-notice button:hover,.cookie-notice button:focus-visible{border-color:var(--accent)}
  @media(max-width:600px){.cookie-notice{inset-inline:12px;bottom:12px;display:block;padding:14px 16px}.cookie-notice>div{margin-top:10px}}
</style>
